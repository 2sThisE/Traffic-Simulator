<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import java.net.URL?>

<BorderPane prefHeight="550.0" prefWidth="750.0" style="-fx-background-color: #1e1e1e;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.trafficsimulator.ui.SignalCycleEditorController">
   <stylesheets>
      <URL value="@style.css" />
   </stylesheets>
   <left>
      <VBox prefWidth="280.0" spacing="15.0" styleClass="sidebar" BorderPane.alignment="CENTER">
         <children>
            <Label styleClass="sidebar-title" text="SIGNAL PHASES" />
            <ListView fx:id="phaseListView" VBox.vgrow="ALWAYS" />
            <GridPane hgap="8.0" vgap="8.0">
              <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
              </columnConstraints>
              <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="35.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="35.0" vgrow="SOMETIMES" />
              </rowConstraints>
               <children>
                  <Button fx:id="addPhaseBtn" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleAddPhase" styleClass="btn-primary" text="+ Add Phase" />
                  <Button fx:id="removePhaseBtn" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleRemovePhase" styleClass="btn-danger" text="Remove" GridPane.columnIndex="1" />
                  <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleMoveUp" text="Move Up ↑" GridPane.rowIndex="1" />
                  <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleMoveDown" text="Move Down ↓" GridPane.columnIndex="1" GridPane.rowIndex="1" />
               </children>
            </GridPane>
         </children>
      </VBox>
   </left>
   <center>
      <VBox spacing="25.0" BorderPane.alignment="CENTER" style="-fx-padding: 20;">
         <children>
            <Label styleClass="sidebar-title" text="PHASE DETAILS" />
            <GridPane hgap="15.0" vgap="20.0">
              <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="120.0" />
                <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" prefWidth="100.0" />
              </columnConstraints>
              <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="35.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
              </rowConstraints>
               <children>
                  <Label text="Duration (Ticks):" textFill="#cccccc" />
                  <TextField fx:id="durationField" promptText="Enter ticks..." GridPane.columnIndex="1" />
                  <Label text="Active Signals:" GridPane.rowIndex="1" textFill="#cccccc" />
                  <!-- vgrow 속성 제거 완료! ❤️ -->
                  <FlowPane fx:id="signalsFlowPane" hgap="12.0" vgap="12.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />
               </children>
            </GridPane>
            <Region VBox.vgrow="ALWAYS" />
            
            <!-- 경고 라벨 ❤️ -->
            <Label fx:id="warningLabel" maxWidth="1.7976931348623157E308" style="-fx-background-color: rgba(231, 76, 60, 0.2); -fx-border-color: #e74c3c; -fx-border-radius: 5; -fx-padding: 10; -fx-text-fill: #ff7675;" text="Warning: YELLOW signal allows straight traffic!" visible="false" wrapText="true">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Label>
            
            <Button fx:id="updatePhaseBtn" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleUpdatePhase" prefHeight="45.0" style="-fx-font-weight: bold;" text="Update Current Phase" />
         </children>
      </VBox>
   </center>
   <bottom>
      <HBox alignment="CENTER_RIGHT" spacing="15.0" style="-fx-background-color: #252526; -fx-border-color: #3e3e3e; -fx-border-width: 1 0 0 0;" BorderPane.alignment="CENTER">
         <children>
            <Button mnemonicParsing="false" onAction="#handleCancel" prefWidth="100.0" text="Close" />
            <Button mnemonicParsing="false" onAction="#handleSave" prefWidth="180.0" styleClass="btn-primary" style="-fx-font-weight: bold;" text="APPLY CYCLE" />
         </children>
         <padding>
            <Insets bottom="15.0" left="15.0" right="20.0" top="15.0" />
         </padding>
      </HBox>
   </bottom>
</BorderPane>
