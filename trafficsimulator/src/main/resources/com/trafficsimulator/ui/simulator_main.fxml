<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.geometry.Insets?>
<?import java.net.URL?>
<?import javafx.scene.image.ImageView?>

<BorderPane fx:id="rootPane" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="800.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.trafficsimulator.ui.SimulatorController">
   <stylesheets>
      <URL value="@style.css" />
   </stylesheets>
   <top>
      <VBox BorderPane.alignment="CENTER">
         <children>
            <MenuBar>
              <menus>
                <Menu mnemonicParsing="false" text="File">
                  <items>
                    <MenuItem mnemonicParsing="false" text="New" />
                    <MenuItem mnemonicParsing="false" text="Open" />
                    <MenuItem mnemonicParsing="false" text="Save" />
                    <MenuItem mnemonicParsing="false" text="Close" />
                  </items>
                </Menu>
                <Menu mnemonicParsing="false" text="Edit">
                  <items>
                    <MenuItem mnemonicParsing="false" text="Delete" />
                  </items>
                </Menu>
                <Menu mnemonicParsing="false" text="Help">
                  <items>
                    <MenuItem mnemonicParsing="false" text="About" />
                  </items>
                </Menu>
              </menus>
            </MenuBar>
            <ToolBar prefHeight="40.0" prefWidth="200.0" style="-fx-background-color: #252526; -fx-border-color: #3e3e3e; -fx-border-width: 0 0 1 0;">
              <items>
                <Button fx:id="startBtn" mnemonicParsing="false" onAction="#handleStartSimulation" styleClass="btn-primary" text="▶ Start Simulation" />
                <Button fx:id="stopBtn" disable="true" mnemonicParsing="false" onAction="#handleStopSimulation" styleClass="btn-danger" text="■ Stop &amp; Reset" />
                  <Separator orientation="VERTICAL" />
                  <Label fx:id="statusLabel" text="Editor Mode" textFill="#888888">
                     <padding>
                        <Insets left="10.0" />
                     </padding>
                  </Label>
                  <Pane HBox.hgrow="ALWAYS" />
                  <Label fx:id="tickLabel" text="Ticks: 0" textFill="#3498db">
                     <font>
                        <Font name="System Bold" size="13.0" />
                     </font>
                     <padding>
                        <Insets right="10.0" />
                     </padding>
                  </Label>
              </items>
            </ToolBar>
         </children>
      </VBox>
   </top>
   <center>
      <SplitPane dividerPositions="0.2, 0.8" BorderPane.alignment="CENTER">
        <items>
            <VBox styleClass="sidebar">
               <children>
                  <Label text="COMPONENTS" styleClass="sidebar-title" />
                  <TreeView fx:id="componentTreeView" VBox.vgrow="ALWAYS" />
               </children>
            </VBox>
            <Pane fx:id="centerContainer" styleClass="canvas-area">
               <children>
                  <Pane fx:id="canvasContainer">
                     <children>
                        <Canvas fx:id="mainCanvas" height="2000.0" width="2000.0" />
                     </children>
                  </Pane>
               </children>
            </Pane>
            <VBox styleClass="sidebar">
               <children>
                  <Label text="PROPERTIES" styleClass="sidebar-title" />
                  <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
                     <content>
                        <GridPane fx:id="propertyGrid" hgap="10.0" vgap="12.0">
                          <columnConstraints>
                            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="120.0" />
                          </columnConstraints>
                          <rowConstraints>
                            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                          </rowConstraints>
                        </GridPane>
                     </content>
                  </ScrollPane>
               </children>
            </VBox>
        </items>
      </SplitPane>
   </center>
</BorderPane>
